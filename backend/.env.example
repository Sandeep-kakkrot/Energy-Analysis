# ─────────────────────────────────────────────
#  Environment Variables — copy to .env and fill
# ─────────────────────────────────────────────

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=campus-energy-secret-key-change-in-prod

# ── JWT Authentication ─────────────────────────────────────────
# Use a long random string — different from SECRET_KEY for defence-in-depth.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=campus-energy-jwt-secret-change-in-prod
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=campus_energy

# ─────────────────────────────────────────────
#  HDFS + Spark Configuration
#  (used by spark_jobs/ — never read by Flask API)
# ─────────────────────────────────────────────

# Set to "true" to use local CSV files (data/raw/) instead of a real HDFS cluster.
# Default is "true" so the app works out-of-the-box without Hadoop.
SPARK_LOCAL_MODE=true

# Path to local CSV files (used when SPARK_LOCAL_MODE=true)
# Run: python scripts/generate_sample_csv.py  to generate these files.
LOCAL_CSV_DIR=data/raw

# ── Real HDFS cluster settings (only used when SPARK_LOCAL_MODE=false) ──
# HDFS NameNode URI (e.g. hdfs://namenode.campus.edu:9000)
HDFS_NAMENODE=hdfs://localhost:9000

# Base directory on HDFS where energy CSV files are stored
# Expected structure: /energy/raw/CB-A_energy.csv, LB-B_energy.csv, ...
HDFS_DATA_PATH=/energy/raw/

# ─────────────────────────────────────────────
#  Apache Hive Configuration
#  Only used when SPARK_LOCAL_MODE=false
#
#  Data flow (production):
#    HDFS CSV files
#      → Hive External Table (energy_records_raw)
#      → Hive Partitioned Table (energy_records, Parquet)
#      → Spark SQL via enableHiveSupport()
#      → spark_summaries MySQL table
#      → Flask REST API
# ─────────────────────────────────────────────

# Set to "true" to read from Hive (recommended).
# Set to "false" to bypass Hive and read raw CSVs from HDFS (legacy).
USE_HIVE=true

# Hive Metastore Thrift URI — connects Spark to the Hive schema registry.
# Run DDL scripts in hive/ddl/ before setting this.
HIVE_METASTORE_URI=thrift://localhost:9083

# Hive database created by hive/ddl/01_create_database.hql
HIVE_DATABASE=campus_energy

# Primary Hive table that Spark reads (partitioned Parquet).
# Created by hive/ddl/03_create_partitioned_table.hql
# Populated by hive/ddl/05_load_partitions.hql
HIVE_TABLE=energy_records

# HDFS path to the Hive warehouse root (used in SparkSession config)
HIVE_WAREHOUSE_DIR=/hive/warehouse

# ── HiveServer2 connection (for beeline / JDBC access) ────────────────────
# Used to execute hive/ddl/ and hive/queries/ scripts directly:
#   beeline -u "jdbc:hive2://${HIVESERVER2_HOST}:${HIVESERVER2_PORT}"
HIVESERVER2_HOST=localhost
HIVESERVER2_PORT=10000
